<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="AnakinCrawlExample" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="anakin_crawl_example" name="Anakin crawl with polling" isExecutable="true">
    <bpmn:startEvent id="Start" name="startUrl"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="StartCrawl" name="Start crawl" zeebe:modelerTemplate="io.anakin.connectors.Anakin.v1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/png;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="apiKey" target="authentication.type" />
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input source="X-API-Key" target="authentication.name" />
          <zeebe:input source="{{secrets.ANAKIN_API_KEY}}" target="authentication.value" />
          <zeebe:input source="startCrawl" target="anakinOperation" />
          <zeebe:input source="=startUrl" target="anakinUrl" />
          <zeebe:input source="=5" target="anakinMaxPages" />
          <zeebe:input source="=1" target="anakinDepth" />
          <zeebe:input source="us" target="anakinCountry" />
          <zeebe:input source="=false" target="anakinUseBrowser" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="https://api.anakin.io/v1/crawl" target="url" />
          <zeebe:input source="={url: anakinUrl, maxPages: anakinMaxPages, depth: anakinDepth, includePatterns: anakinIncludePatterns, excludePatterns: anakinExcludePatterns, country: anakinCountry, useBrowser: anakinUseBrowser}" target="body" />
          <zeebe:input source="=true" target="ignoreNullValues" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=120" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={crawlJob: response.body}" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
    <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Wait" name="Wait 15 seconds"><bpmn:incoming>F2</bpmn:incoming><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:timerEventDefinition id="WaitTimer"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="GetCrawl" name="Get crawl result" zeebe:modelerTemplate="io.anakin.connectors.Anakin.v1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/png;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="apiKey" target="authentication.type" />
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input source="X-API-Key" target="authentication.name" />
          <zeebe:input source="{{secrets.ANAKIN_API_KEY}}" target="authentication.value" />
          <zeebe:input source="getCrawl" target="anakinOperation" />
          <zeebe:input source="=crawlJob.jobId" target="anakinJobId" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="=&#34;https://api.anakin.io/v1/crawl/&#34; + anakinJobId" target="url" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=120" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={crawlResult: response.body}" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
    <bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Done" name="Finished?" default="F6"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing><bpmn:outgoing>F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End"><bpmn:incoming>F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="StartCrawl"/>
    <bpmn:sequenceFlow id="F2" sourceRef="StartCrawl" targetRef="Wait"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Wait" targetRef="GetCrawl"/>
    <bpmn:sequenceFlow id="F4" sourceRef="GetCrawl" targetRef="Done"/>
    <bpmn:sequenceFlow id="F5" name="yes" sourceRef="Done" targetRef="End"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=list contains(["completed","failed"], crawlResult.status)</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6" name="no" sourceRef="Done" targetRef="Wait"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="DG"><bpmndi:BPMNPlane id="PL" bpmnElement="anakin_crawl_example">
    <bpmndi:BPMNShape id="Start_d" bpmnElement="Start"><dc:Bounds x="150" y="102" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="148" y="142" width="40" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="StartCrawl_d" bpmnElement="StartCrawl"><dc:Bounds x="240" y="80" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Wait_d" bpmnElement="Wait"><dc:Bounds x="402" y="102" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="380" y="80" width="80" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="GetCrawl_d" bpmnElement="GetCrawl"><dc:Bounds x="490" y="80" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Done_d" bpmnElement="Done" isMarkerVisible="true"><dc:Bounds x="645" y="95" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="640" y="72" width="60" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_d" bpmnElement="End"><dc:Bounds x="752" y="102" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F1_d" bpmnElement="F1"><di:waypoint x="186" y="120"/><di:waypoint x="240" y="120"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F2_d" bpmnElement="F2"><di:waypoint x="340" y="120"/><di:waypoint x="402" y="120"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F3_d" bpmnElement="F3"><di:waypoint x="438" y="120"/><di:waypoint x="490" y="120"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F4_d" bpmnElement="F4"><di:waypoint x="590" y="120"/><di:waypoint x="645" y="120"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F5_d" bpmnElement="F5"><di:waypoint x="695" y="120"/><di:waypoint x="752" y="120"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F6_d" bpmnElement="F6"><di:waypoint x="670" y="145"/><di:waypoint x="670" y="210"/><di:waypoint x="420" y="210"/><di:waypoint x="420" y="138"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
