{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "Anakin",
  "id": "io.anakin.connectors.Anakin.v1",
  "version": 1,
  "description": "Scrape, crawl, map and search the web and get Markdown or JSON back.",
  "metadata": {
    "keywords": [
      "anakin",
      "web scraping",
      "crawl",
      "search",
      "markdown"
    ]
  },
  "documentationRef": "https://github.com/Anakin-Inc/camunda-connector-anakin#readme",
  "category": {
    "id": "connectors",
    "name": "Connectors"
  },
  "appliesTo": [
    "bpmn:Task"
  ],
  "elementType": {
    "value": "bpmn:ServiceTask"
  },
  "engines": {
    "camunda": "^8.9"
  },
  "icon": {
    "contents": "data:image/png;base64,"
  },
  "groups": [
    {
      "id": "authentication",
      "label": "Authentication"
    },
    {
      "id": "operation",
      "label": "Operation"
    },
    {
      "id": "input",
      "label": "Input"
    },
    {
      "id": "timeout",
      "label": "Connection timeout"
    },
    {
      "id": "output",
      "label": "Output mapping"
    },
    {
      "id": "error",
      "label": "Error handling"
    },
    {
      "id": "retries",
      "label": "Retries"
    }
  ],
  "properties": [
    {
      "type": "Hidden",
      "value": "io.camunda:http-json:1",
      "binding": {
        "type": "zeebe:taskDefinition",
        "property": "type"
      }
    },
    {
      "id": "authentication.type",
      "type": "Hidden",
      "value": "apiKey",
      "binding": {
        "name": "authentication.type",
        "type": "zeebe:input"
      }
    },
    {
      "id": "authentication.apiKeyLocation",
      "type": "Hidden",
      "value": "headers",
      "binding": {
        "name": "authentication.apiKeyLocation",
        "type": "zeebe:input"
      }
    },
    {
      "id": "authentication.name",
      "type": "Hidden",
      "value": "X-API-Key",
      "binding": {
        "name": "authentication.name",
        "type": "zeebe:input"
      }
    },
    {
      "id": "authentication.value",
      "label": "Anakin API key",
      "group": "authentication",
      "type": "String",
      "value": "{{secrets.ANAKIN_API_KEY}}",
      "feel": "optional",
      "binding": {
        "name": "authentication.value",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "description": "Store the key as a connector secret named ANAKIN_API_KEY. Create a key at <a href=\"https://anakin.io/dashboard\" target=\"_blank\">anakin.io/dashboard</a>."
    },
    {
      "id": "anakinOperation",
      "label": "Operation",
      "group": "operation",
      "type": "Dropdown",
      "value": "scrape",
      "binding": {
        "name": "anakinOperation",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "choices": [
        {
          "name": "Scrape URL",
          "value": "scrape"
        },
        {
          "name": "Get scrape result",
          "value": "getScrape"
        },
        {
          "name": "AI search",
          "value": "search"
        },
        {
          "name": "Start crawl",
          "value": "startCrawl"
        },
        {
          "name": "Get crawl result",
          "value": "getCrawl"
        },
        {
          "name": "Start site map",
          "value": "startMap"
        },
        {
          "name": "Get site map result",
          "value": "getMap"
        },
        {
          "name": "Start agentic search",
          "value": "startAgenticSearch"
        },
        {
          "name": "Get agentic search result",
          "value": "getAgenticSearch"
        }
      ]
    },
    {
      "id": "anakinUrl",
      "label": "URL",
      "group": "input",
      "type": "String",
      "binding": {
        "name": "anakinUrl",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "oneOf": [
          "scrape",
          "startCrawl",
          "startMap"
        ],
        "type": "simple"
      },
      "description": "Page to scrape, or the start URL of a crawl or site map.",
      "feel": "optional",
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "id": "anakinPrompt",
      "label": "Prompt",
      "group": "input",
      "type": "Text",
      "binding": {
        "name": "anakinPrompt",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "oneOf": [
          "search",
          "startAgenticSearch"
        ],
        "type": "simple"
      },
      "description": "Question or research task in natural language.",
      "feel": "optional",
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "id": "anakinJobId",
      "label": "Job ID",
      "group": "input",
      "type": "String",
      "binding": {
        "name": "anakinJobId",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "oneOf": [
          "getScrape",
          "getCrawl",
          "getMap",
          "getAgenticSearch"
        ],
        "type": "simple"
      },
      "description": "Returned when the job started: <code>=anakinResult.jobId</code> for crawl and site map, <code>=anakinResult.job_id</code> for agentic search, <code>=anakinResult.id</code> for scrape.",
      "feel": "optional",
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "id": "anakinFormats",
      "label": "Formats",
      "group": "input",
      "type": "String",
      "binding": {
        "name": "anakinFormats",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "scrape",
        "type": "simple"
      },
      "description": "FEEL list. Any of markdown, html, cleanedHtml, links, images, summary, screenshot, screenshotFullPage, json.",
      "value": "=[\"markdown\"]",
      "feel": "required",
      "optional": true
    },
    {
      "id": "anakinLimitSearch",
      "label": "Result limit",
      "group": "input",
      "type": "Number",
      "binding": {
        "name": "anakinLimit",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "search",
        "type": "simple"
      },
      "value": 5,
      "feel": "static",
      "optional": true
    },
    {
      "id": "anakinMaxPages",
      "label": "Max pages",
      "group": "input",
      "type": "Number",
      "binding": {
        "name": "anakinMaxPages",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "startCrawl",
        "type": "simple"
      },
      "value": 10,
      "feel": "static",
      "optional": true
    },
    {
      "id": "anakinDepthCrawl",
      "label": "Depth",
      "group": "input",
      "type": "Number",
      "binding": {
        "name": "anakinDepth",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "startCrawl",
        "type": "simple"
      },
      "value": 1,
      "feel": "static",
      "optional": true
    },
    {
      "id": "anakinIncludePatterns",
      "label": "Include patterns",
      "group": "input",
      "type": "String",
      "binding": {
        "name": "anakinIncludePatterns",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "startCrawl",
        "type": "simple"
      },
      "description": "FEEL list of URL patterns to follow, for example <code>=[\"/blog/*\"]</code>.",
      "feel": "required",
      "optional": true
    },
    {
      "id": "anakinExcludePatterns",
      "label": "Exclude patterns",
      "group": "input",
      "type": "String",
      "binding": {
        "name": "anakinExcludePatterns",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "startCrawl",
        "type": "simple"
      },
      "description": "FEEL list of URL patterns to skip.",
      "feel": "required",
      "optional": true
    },
    {
      "id": "anakinLimitMap",
      "label": "URL limit",
      "group": "input",
      "type": "Number",
      "binding": {
        "name": "anakinLimit",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "startMap",
        "type": "simple"
      },
      "description": "Maximum 5000.",
      "value": 100,
      "feel": "static",
      "optional": true
    },
    {
      "id": "anakinDepthMap",
      "label": "Depth",
      "group": "input",
      "type": "Number",
      "binding": {
        "name": "anakinDepth",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "startMap",
        "type": "simple"
      },
      "description": "Maximum 5.",
      "value": 2,
      "feel": "static",
      "optional": true
    },
    {
      "id": "anakinSearch",
      "label": "Filter",
      "group": "input",
      "type": "String",
      "binding": {
        "name": "anakinSearch",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "startMap",
        "type": "simple"
      },
      "description": "Only return URLs that match this text.",
      "feel": "optional",
      "optional": true
    },
    {
      "id": "anakinIncludeSubdomains",
      "label": "Include subdomains",
      "group": "input",
      "type": "Boolean",
      "binding": {
        "name": "anakinIncludeSubdomains",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "startMap",
        "type": "simple"
      },
      "value": false,
      "feel": "static",
      "optional": true
    },
    {
      "id": "anakinSchema",
      "label": "Output schema",
      "group": "input",
      "type": "Text",
      "binding": {
        "name": "anakinSchema",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "startAgenticSearch",
        "type": "simple"
      },
      "description": "Optional JSON Schema, as a FEEL context, for the structured result. Inferred when empty.",
      "feel": "required",
      "optional": true
    },
    {
      "id": "anakinCountry",
      "label": "Country",
      "group": "input",
      "type": "String",
      "binding": {
        "name": "anakinCountry",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "oneOf": [
          "scrape",
          "startCrawl"
        ],
        "type": "simple"
      },
      "description": "Two-letter country code to fetch from.",
      "value": "us",
      "feel": "optional",
      "optional": true
    },
    {
      "id": "anakinForceFresh",
      "label": "Force fresh",
      "group": "input",
      "type": "Boolean",
      "binding": {
        "name": "anakinForceFresh",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "scrape",
        "type": "simple"
      },
      "description": "Skip the cache and fetch the page again.",
      "value": false,
      "feel": "static",
      "optional": true
    },
    {
      "id": "anakinUseBrowser",
      "label": "Use browser",
      "group": "input",
      "type": "Boolean",
      "binding": {
        "name": "anakinUseBrowser",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "oneOf": [
          "scrape",
          "startCrawl",
          "startMap"
        ],
        "type": "simple"
      },
      "description": "Render with a headless browser. Use for pages built with JavaScript.",
      "value": false,
      "feel": "static",
      "optional": true
    },
    {
      "id": "anakinUseBrowserAgentic",
      "label": "Use browser",
      "group": "input",
      "type": "Boolean",
      "binding": {
        "name": "anakinUseBrowser",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "startAgenticSearch",
        "type": "simple"
      },
      "value": true,
      "feel": "static",
      "optional": true
    },
    {
      "id": "method.post",
      "type": "Hidden",
      "value": "POST",
      "binding": {
        "name": "method",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "oneOf": [
          "scrape",
          "search",
          "startCrawl",
          "startMap",
          "startAgenticSearch"
        ],
        "type": "simple"
      }
    },
    {
      "id": "method.get",
      "type": "Hidden",
      "value": "GET",
      "binding": {
        "name": "method",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "oneOf": [
          "getScrape",
          "getCrawl",
          "getMap",
          "getAgenticSearch"
        ],
        "type": "simple"
      }
    },
    {
      "id": "url.scrape",
      "type": "Hidden",
      "value": "https://api.anakin.io/v1/url-scraper/scrape",
      "binding": {
        "name": "url",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "scrape",
        "type": "simple"
      }
    },
    {
      "id": "url.getScrape",
      "type": "Hidden",
      "value": "=\"https://api.anakin.io/v1/url-scraper/\" + anakinJobId",
      "binding": {
        "name": "url",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "getScrape",
        "type": "simple"
      }
    },
    {
      "id": "url.search",
      "type": "Hidden",
      "value": "https://api.anakin.io/v1/search",
      "binding": {
        "name": "url",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "search",
        "type": "simple"
      }
    },
    {
      "id": "url.startCrawl",
      "type": "Hidden",
      "value": "https://api.anakin.io/v1/crawl",
      "binding": {
        "name": "url",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "startCrawl",
        "type": "simple"
      }
    },
    {
      "id": "url.getCrawl",
      "type": "Hidden",
      "value": "=\"https://api.anakin.io/v1/crawl/\" + anakinJobId",
      "binding": {
        "name": "url",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "getCrawl",
        "type": "simple"
      }
    },
    {
      "id": "url.startMap",
      "type": "Hidden",
      "value": "https://api.anakin.io/v1/map",
      "binding": {
        "name": "url",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "startMap",
        "type": "simple"
      }
    },
    {
      "id": "url.getMap",
      "type": "Hidden",
      "value": "=\"https://api.anakin.io/v1/map/\" + anakinJobId",
      "binding": {
        "name": "url",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "getMap",
        "type": "simple"
      }
    },
    {
      "id": "url.startAgenticSearch",
      "type": "Hidden",
      "value": "https://api.anakin.io/v1/agentic-search",
      "binding": {
        "name": "url",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "startAgenticSearch",
        "type": "simple"
      }
    },
    {
      "id": "url.getAgenticSearch",
      "type": "Hidden",
      "value": "=\"https://api.anakin.io/v1/agentic-search/\" + anakinJobId",
      "binding": {
        "name": "url",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "getAgenticSearch",
        "type": "simple"
      }
    },
    {
      "id": "body.scrape",
      "type": "Hidden",
      "value": "={url: anakinUrl, formats: anakinFormats, country: anakinCountry, useBrowser: anakinUseBrowser, forceFresh: anakinForceFresh}",
      "binding": {
        "name": "body",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "scrape",
        "type": "simple"
      }
    },
    {
      "id": "body.search",
      "type": "Hidden",
      "value": "={prompt: anakinPrompt, limit: anakinLimit}",
      "binding": {
        "name": "body",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "search",
        "type": "simple"
      }
    },
    {
      "id": "body.startCrawl",
      "type": "Hidden",
      "value": "={url: anakinUrl, maxPages: anakinMaxPages, depth: anakinDepth, includePatterns: anakinIncludePatterns, excludePatterns: anakinExcludePatterns, country: anakinCountry, useBrowser: anakinUseBrowser}",
      "binding": {
        "name": "body",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "startCrawl",
        "type": "simple"
      }
    },
    {
      "id": "body.startMap",
      "type": "Hidden",
      "value": "={url: anakinUrl, limit: anakinLimit, depth: anakinDepth, includeSubdomains: anakinIncludeSubdomains, search: anakinSearch, useBrowser: anakinUseBrowser}",
      "binding": {
        "name": "body",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "startMap",
        "type": "simple"
      }
    },
    {
      "id": "body.startAgenticSearch",
      "type": "Hidden",
      "value": "={prompt: anakinPrompt, schema: anakinSchema, useBrowser: anakinUseBrowser}",
      "binding": {
        "name": "body",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "equals": "startAgenticSearch",
        "type": "simple"
      }
    },
    {
      "id": "ignoreNullValues",
      "type": "Hidden",
      "value": "=true",
      "binding": {
        "name": "ignoreNullValues",
        "type": "zeebe:input"
      },
      "condition": {
        "property": "anakinOperation",
        "oneOf": [
          "scrape",
          "search",
          "startCrawl",
          "startMap",
          "startAgenticSearch"
        ],
        "type": "simple"
      }
    },
    {
      "id": "connectionTimeoutInSeconds",
      "type": "Hidden",
      "value": "=20",
      "binding": {
        "name": "connectionTimeoutInSeconds",
        "type": "zeebe:input"
      }
    },
    {
      "id": "readTimeoutInSeconds",
      "label": "Read timeout in seconds",
      "group": "timeout",
      "type": "Number",
      "value": 120,
      "feel": "static",
      "binding": {
        "name": "readTimeoutInSeconds",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "id": "resultVariable",
      "label": "Result variable",
      "group": "output",
      "type": "String",
      "optional": true,
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "resultVariable"
      },
      "description": "Stores the whole HTTP response, including headers. The result expression is usually enough."
    },
    {
      "id": "resultExpression",
      "label": "Result expression",
      "group": "output",
      "type": "Text",
      "feel": "required",
      "value": "={anakinResult: response.body}",
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "resultExpression"
      }
    },
    {
      "id": "errorExpression",
      "label": "Error expression",
      "group": "error",
      "type": "Text",
      "feel": "required",
      "optional": true,
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "errorExpression"
      },
      "description": "Turn errors into BPMN errors. See the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/\" target=\"_blank\">documentation</a>."
    },
    {
      "id": "retryCount",
      "label": "Retries",
      "group": "retries",
      "type": "String",
      "value": "3",
      "feel": "optional",
      "binding": {
        "type": "zeebe:taskDefinition",
        "property": "retries"
      }
    },
    {
      "id": "retryBackoff",
      "label": "Retry backoff",
      "group": "retries",
      "type": "String",
      "value": "PT30S",
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "retryBackoff"
      }
    }
  ]
}
